# Set these in Netlify -> Project configuration -> Environment variables.
# Never commit real API keys.
API_FOOTBALL_KEY=your_api_football_key
ODDS_API_KEY=your_the_odds_api_key
LIVE_DATA_ENABLED=true
API_TIMEOUT_MS=10000
API_FOOTBALL_RECENT_MATCHES=10
ODDS_REGIONS=eu
ODDS_SPORT_NBA=basketball_nba
ODDS_SPORT_NHL=icehockey_nhl
ODDS_SPORT_CZ_FOOTBALL=
ODDS_SPORT_FIFA=


# SharePoint / Microsoft Graph (AI_Predictions)
MS_TENANT_ID=your_microsoft_entra_tenant_id
MS_CLIENT_ID=your_app_registration_client_id
MS_CLIENT_SECRET=your_app_registration_client_secret
SHAREPOINT_SITE_ID=your_sharepoint_site_id
SHAREPOINT_PREDICTIONS_LIST_ID=your_ai_predictions_list_id
